APP_ENV=development
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lectureai
POSTGRES_USER=lectureai
POSTGRES_PASSWORD=lectureai

# Redis
REDIS_URL=redis://localhost:6379/0

# Minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lectures
MINIO_SECURE=false

# LLM
# LLM_MODEL must support PDF file input (e.g. qwen3.8-flash)
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://token-plan.maas.qwencloudapi.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_MAX_TOKENS=4096

# Password recovery. Local mailbox: docker compose --profile mail up -d mailpit
FRONTEND_URL=http://localhost:8080
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=StudyAI <noreply@studyai.local>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA